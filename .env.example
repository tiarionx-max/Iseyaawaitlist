# Supabase project URL (Project Settings → API)
SUPABASE_URL=

# Supabase service role key — server-side only, never exposed to the client.
# Used by app/api/waitlist/route.ts to insert into the `waitlist` table.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://iseyaa.com
